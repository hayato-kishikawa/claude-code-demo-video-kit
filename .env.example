# コピーして .env にし、どちらか一方の接続先を埋める（.env は git に入れない）
#   cp .env.example .env

# --- A. Azure OpenAI（作者が実測した構成） ---
PROVIDER=azure
# リソースのエンドポイント＋ /openai/v1（OpenAI 互換の v1 API）
AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
# デプロイ名（モデル名と同じ名前でデプロイしておくと楽）
# 画像は gpt-image-2.5-flare（標準・速い）か gpt-image-2.5-sunburst（精度優先）
IMAGE_DEPLOYMENT=gpt-image-2.5-flare
REALTIME_DEPLOYMENT=gpt-realtime-2.1
# 費用の集計用。DataZone 標準でデプロイしたものは DataZoneStandard（単価が Global の 1.1 倍）
# IMAGE_SKU=GlobalStandard
# REALTIME_SKU=GlobalStandard

# --- B. OpenAI API（コード上は対応。作者は未検証） ---
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_DEPLOYMENT=gpt-image-2.5-flare
# REALTIME_DEPLOYMENT=gpt-realtime-2.1

# --- 任意 ---
# ナレーションの話速（既定 1.15。CM 調なら 1.2〜1.25）
# ATEMPO=1.15
